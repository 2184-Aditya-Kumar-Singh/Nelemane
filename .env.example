# Base URL used for absolute links and signed local-development media URLs.
APP_URL=http://localhost:3000

# Auth.js secret used to sign authentication tokens. Generate a random value of at least 32 characters.
AUTH_SECRET=replace-with-the-same-random-secret-for-both-auth-variables

# Compatibility URL for NextAuth-based tooling; keep it aligned with APP_URL.
NEXTAUTH_URL=http://localhost:3000

# Compatibility secret for NextAuth-based tooling; keep it identical to AUTH_SECRET.
NEXTAUTH_SECRET=replace-with-the-same-random-secret-for-both-auth-variables

# MongoDB connection string for the application database.
MONGODB_URI=mongodb://127.0.0.1:27017/nelemane

# Cloudinary account name; leave the Cloudinary variables blank to use local development storage.
CLOUDINARY_CLOUD_NAME=

# Cloudinary API key; leave blank with the other Cloudinary settings to use local development storage.
CLOUDINARY_API_KEY=

# Cloudinary API secret; leave blank with the other Cloudinary settings to use local development storage.
CLOUDINARY_API_SECRET=

# Resend API key; when omitted, configured SMTP credentials are used for email delivery.
RESEND_API_KEY=

# MSG91 API key; leave blank in development to log SMS notifications locally.
MSG91_AUTH_KEY=

# MSG91 sender ID registered for the account's DLT templates.
MSG91_SENDER_ID=

# MSG91 DLT flow template ID used for transactional SMS.
MSG91_TEMPLATE_ID=

# Secret used to authorize the scheduled daily cron endpoint.
CRON_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Base64-encoded 32-byte key used for AES-256-GCM encryption of sensitive values.
DATA_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Super Admin email used for initial account setup and platform notifications.
ADMIN_EMAIL=admin@example.com

# Temporary password for the Super Admin created by the seed script; change it before production use.
ADMIN_INITIAL_PASSWORD=replace-with-a-long-unique-password

# SMTP host used when Resend is not configured.
SMTP_HOST=

# SMTP port used when Resend is not configured; use 465 for implicit TLS or 587 for STARTTLS.
SMTP_PORT=465

# SMTP username used when Resend is not configured.
SMTP_USER=

# SMTP password or application password used when Resend is not configured.
SMTP_PASS=

# Verified sender address used by email providers.
EMAIL_FROM=
